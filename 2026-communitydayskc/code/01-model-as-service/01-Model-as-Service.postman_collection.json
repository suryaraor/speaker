{
  "info": {
    "name": "01 - Model as a Service",
    "description": "Postman collection for testing the Model as a Service pattern - Python ML service with Spring Boot client",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "Python ML Service",
      "description": "FastAPI fraud detection model service running on port 8000",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ml_service_url}}/health",
              "host": [
                "{{ml_service_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Check if the ML service is healthy and model is loaded"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has status healthy', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('healthy');",
                  "});",
                  "",
                  "pm.test('Model is loaded', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.model_loaded).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Predict Fraud - High Risk",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1850.0,\n  \"hour_of_day\": 3,\n  \"merchant_risk_score\": 0.8,\n  \"velocity_30d\": 22,\n  \"geo_risk_score\": 0.75\n}"
            },
            "url": {
              "raw": "{{ml_service_url}}/predict/fraud",
              "host": [
                "{{ml_service_url}}"
              ],
              "path": [
                "predict",
                "fraud"
              ]
            },
            "description": "Submit transaction features for fraud prediction (high-risk example)"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains fraud_probability', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('fraud_probability');",
                  "    pm.expect(jsonData.fraud_probability).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('Response contains is_fraud flag', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('is_fraud');",
                  "    pm.expect(jsonData.is_fraud).to.be.a('boolean');",
                  "});",
                  "",
                  "pm.test('Response contains risk_level', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.risk_level).to.be.oneOf(['LOW', 'MEDIUM', 'HIGH']);",
                  "});",
                  "",
                  "pm.test('Response contains feature_importances', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('feature_importances');",
                  "    pm.expect(jsonData.feature_importances).to.be.an('object');",
                  "});"
                ]
              }
            }
          ]
        },
