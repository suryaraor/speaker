        {
          "name": "Evaluate Transaction - Synchronous",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"TXN-20260523-001\",\n  \"accountId\": \"ACC-98765\",\n  \"amount\": 2500.0,\n  \"timestamp\": \"2026-05-23T02:45:00Z\",\n  \"merchantId\": \"MERCH-CRYPTO-5555\",\n  \"merchantCategory\": \"CRYPTO\",\n  \"location\": \"NG\",\n  \"ipAddress\": \"41.203.150.200\"\n}"
            },
            "url": {
              "raw": "{{spring_boot_url}}/api/fraud/evaluate",
              "host": [
                "{{spring_boot_url}}"
              ],
              "path": [
                "api",
                "fraud",
                "evaluate"
              ]
            },
            "description": "Evaluate a custom transaction (blocking/synchronous call). Feature engineering happens in Java, prediction from Python ML service."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains fraud_probability', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('fraud_probability');",
                  "    pm.expect(jsonData.fraud_probability).to.be.a('number');",
                  "    pm.expect(jsonData.fraud_probability).to.be.within(0, 1);",
                  "});",
                  "",
                  "pm.test('Response contains is_fraud flag', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('is_fraud');",
                  "    pm.expect(jsonData.is_fraud).to.be.a('boolean');",
                  "});",
                  "",
                  "pm.test('Response contains risk_level', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('risk_level');",
                  "    pm.expect(jsonData.risk_level).to.be.oneOf(['LOW', 'MEDIUM', 'HIGH']);",
                  "});",
                  "",
                  "pm.test('Response includes model_version', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('model_version');",
                  "});"
                ]
              }
            }
          ]
        },
