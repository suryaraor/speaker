                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Async endpoint returns quickly', function () {",
                  "    // This is a reactive endpoint that should return immediately",
